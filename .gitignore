# Python caches / build artifacts
__pycache__/
*.pyc
.*_cache/
.pytest_cache/
*.egg-info/
dist/
build/

# Environments / lockfiles (test suite tooling only)
.env
.venv/
uv.lock

# Developer-local SBTDD workflow artifacts — not part of the shipped plugin
# Anchored to repo root so they never match nested paths like skills/sbtdd/
/.claude/
/sbtdd/
/planning/
/CLAUDE.md
/CLAUDE.local.md
/.remember/

# Internal planning/process docs — kept local, not published
docs/superpowers/
# MAGI-Hang incident — local working artifacts (raw notes + handoff to MAGI
# maintainer). Listed explicitly so future doc/MAGI-Hang-* files (e.g. a
# post-mortem someone DOES want to track) are not hidden silently.
docs/MAGI-Hang.txt
docs/MAGI-Hang-Handoff.md
graphify-out/

# OS / editor cruft
Thumbs.db
.DS_Store
*.swp
